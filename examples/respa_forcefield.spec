# RESPA / r-RESPA multiple-time-stepping for a classical molecular-dynamics
# FORCE FIELD: harmonic bonds (fast) + Lennard-Jones + Coulomb (slow).
#
# A 1-D chain of 6 atoms with the standard biomolecular force-field potential
#   V = (k/2) sum_bonds (q_{i+1} - q_i - b)^2                       (bonds, FAST)
#     + sum_nonbonded 4 eps ((sg/r_ij)^12 - (sg/r_ij)^6)             (Lennard-Jones)
#     + sum_nonbonded ke q_i q_j / r_ij                              (Coulomb)
# i.e. the bonded + van der Waals + electrostatic terms of the AMBER/CHARMM/OPLS
# form (here without angles/dihedrals).  r_ij = sqrt((q_j - q_i)^2); each atom i
# carries a charge Q_i.  Nonbonded pairs exclude 1-2 (bond) and 1-3 (angle)
# neighbours, i.e. |i-j| > 2; the 6 nonbonded pairs are: 1-4, 1-5, 1-6, 2-5, 2-6, 3-6.
#
# r-RESPA evaluates the expensive nonbonded force (LJ + Coulomb) once per long
# step h while resolving the stiff bonded force on dt = h/4:
#       slow half-kick (h/2)
#       while^4:  fast bonded leapfrog, inner step dt = h/4
#       slow half-kick (h/2)
# Every kick is the exact gradient of its potential (symplectic shear); the
# verifier pulls the canonical form sum_i dq_i^dp_i back through the whole map
# and confirms it is preserved -- so this multiple-time-stepping MD integrator
# is symplectic.  Forces below were generated by symbolic differentiation.
#
# Refs (full system + integrator):
#   * Force-field form: W. D. Cornell et al. (AMBER), "A Second Generation Force
#     Field for the Simulation of Proteins, Nucleic Acids, and Organic
#     Molecules", J. Am. Chem. Soc. 117, 5179-5197 (1995), Eq. 1;
#   * r-RESPA: M. Tuckerman, B. J. Berne & G. J. Martyna, J. Chem. Phys. 97,
#     1990-2001 (1992);
#   * LJ + electrostatics multiple-time-stepping: P. Procacci, M. Marchi &
#     G. J. Martyna, J. Chem. Phys. 108, 8799 (1998).

coords q1 q2 q3 q4 q5 q6 p1 p2 p3 p4 p5 p6
params h k b eps sg ke Q1 Q2 Q3 Q4 Q5 Q6

pre  dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4 + dq5 ^ dp5 + dq6 ^ dp6
post dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4 + dq5 ^ dp5 + dq6 ^ dp6

program {
    # ---- slow half-kick: Lennard-Jones + Coulomb nonbonded force (h/2) ----
    (p1, p2, p3, p4, p5, p6) := (
        1/2*(Q1*Q4*ke*(q1 - q4)/((q1 - q4)**2)**(3/2) + Q1*Q5*ke*(q1 - q5)/((q1 - q5)**2)**(3/2) + Q1*Q6*ke*(q1 - q6)/((q1 - q6)**2)**(3/2) - 24*eps*(sg**6/(q1 - q4)**7 - 2*sg**12/(q1 - q4)**13) - 24*eps*(sg**6/(q1 - q5)**7 - 2*sg**12/(q1 - q5)**13) - 24*eps*(sg**6/(q1 - q6)**7 - 2*sg**12/(q1 - q6)**13))*h + p1,
        1/2*(Q2*Q5*ke*(q2 - q5)/((q2 - q5)**2)**(3/2) + Q2*Q6*ke*(q2 - q6)/((q2 - q6)**2)**(3/2) - 24*eps*(sg**6/(q2 - q5)**7 - 2*sg**12/(q2 - q5)**13) - 24*eps*(sg**6/(q2 - q6)**7 - 2*sg**12/(q2 - q6)**13))*h + p2,
        1/2*(Q3*Q6*ke*(q3 - q6)/((q3 - q6)**2)**(3/2) - 24*eps*(sg**6/(q3 - q6)**7 - 2*sg**12/(q3 - q6)**13))*h + p3,
        -1/2*(Q1*Q4*ke*(q1 - q4)/((q1 - q4)**2)**(3/2) - 24*eps*(sg**6/(q1 - q4)**7 - 2*sg**12/(q1 - q4)**13))*h + p4,
        -1/2*(Q1*Q5*ke*(q1 - q5)/((q1 - q5)**2)**(3/2) + Q2*Q5*ke*(q2 - q5)/((q2 - q5)**2)**(3/2) - 24*eps*(sg**6/(q1 - q5)**7 - 2*sg**12/(q1 - q5)**13) - 24*eps*(sg**6/(q2 - q5)**7 - 2*sg**12/(q2 - q5)**13))*h + p5,
        -1/2*(Q1*Q6*ke*(q1 - q6)/((q1 - q6)**2)**(3/2) + Q2*Q6*ke*(q2 - q6)/((q2 - q6)**2)**(3/2) + Q3*Q6*ke*(q3 - q6)/((q3 - q6)**2)**(3/2) - 24*eps*(sg**6/(q1 - q6)**7 - 2*sg**12/(q1 - q6)**13) - 24*eps*(sg**6/(q2 - q6)**7 - 2*sg**12/(q2 - q6)**13) - 24*eps*(sg**6/(q3 - q6)**7 - 2*sg**12/(q3 - q6)**13))*h + p6
    )

    while^4 {
        # ---- fast half-kick: harmonic bond force (dt/2) ----
    (p1, p2, p3, p4, p5, p6) := (
        -1/8*(b + q1 - q2)*h*k + p1,
        1/8*h*k*(q1 - 2*q2 + q3) + p2,
        1/8*h*k*(q2 - 2*q3 + q4) + p3,
        1/8*h*k*(q3 - 2*q4 + q5) + p4,
        1/8*h*k*(q4 - 2*q5 + q6) + p5,
        1/8*(b + q5 - q6)*h*k + p6
    )

        # ---- drift (dt = h/4) ----
    (q1, q2, q3, q4, q5, q6) := (
        1/4*h*p1 + q1,
        1/4*h*p2 + q2,
        1/4*h*p3 + q3,
        1/4*h*p4 + q4,
        1/4*h*p5 + q5,
        1/4*h*p6 + q6
    )

        # ---- fast half-kick: harmonic bond force (dt/2) ----
    (p1, p2, p3, p4, p5, p6) := (
        -1/8*(b + q1 - q2)*h*k + p1,
        1/8*h*k*(q1 - 2*q2 + q3) + p2,
        1/8*h*k*(q2 - 2*q3 + q4) + p3,
        1/8*h*k*(q3 - 2*q4 + q5) + p4,
        1/8*h*k*(q4 - 2*q5 + q6) + p5,
        1/8*(b + q5 - q6)*h*k + p6
    )
    }

    # ---- slow half-kick: Lennard-Jones + Coulomb nonbonded force (h/2) ----
    (p1, p2, p3, p4, p5, p6) := (
        1/2*(Q1*Q4*ke*(q1 - q4)/((q1 - q4)**2)**(3/2) + Q1*Q5*ke*(q1 - q5)/((q1 - q5)**2)**(3/2) + Q1*Q6*ke*(q1 - q6)/((q1 - q6)**2)**(3/2) - 24*eps*(sg**6/(q1 - q4)**7 - 2*sg**12/(q1 - q4)**13) - 24*eps*(sg**6/(q1 - q5)**7 - 2*sg**12/(q1 - q5)**13) - 24*eps*(sg**6/(q1 - q6)**7 - 2*sg**12/(q1 - q6)**13))*h + p1,
        1/2*(Q2*Q5*ke*(q2 - q5)/((q2 - q5)**2)**(3/2) + Q2*Q6*ke*(q2 - q6)/((q2 - q6)**2)**(3/2) - 24*eps*(sg**6/(q2 - q5)**7 - 2*sg**12/(q2 - q5)**13) - 24*eps*(sg**6/(q2 - q6)**7 - 2*sg**12/(q2 - q6)**13))*h + p2,
        1/2*(Q3*Q6*ke*(q3 - q6)/((q3 - q6)**2)**(3/2) - 24*eps*(sg**6/(q3 - q6)**7 - 2*sg**12/(q3 - q6)**13))*h + p3,
        -1/2*(Q1*Q4*ke*(q1 - q4)/((q1 - q4)**2)**(3/2) - 24*eps*(sg**6/(q1 - q4)**7 - 2*sg**12/(q1 - q4)**13))*h + p4,
        -1/2*(Q1*Q5*ke*(q1 - q5)/((q1 - q5)**2)**(3/2) + Q2*Q5*ke*(q2 - q5)/((q2 - q5)**2)**(3/2) - 24*eps*(sg**6/(q1 - q5)**7 - 2*sg**12/(q1 - q5)**13) - 24*eps*(sg**6/(q2 - q5)**7 - 2*sg**12/(q2 - q5)**13))*h + p5,
        -1/2*(Q1*Q6*ke*(q1 - q6)/((q1 - q6)**2)**(3/2) + Q2*Q6*ke*(q2 - q6)/((q2 - q6)**2)**(3/2) + Q3*Q6*ke*(q3 - q6)/((q3 - q6)**2)**(3/2) - 24*eps*(sg**6/(q1 - q6)**7 - 2*sg**12/(q1 - q6)**13) - 24*eps*(sg**6/(q2 - q6)**7 - 2*sg**12/(q2 - q6)**13) - 24*eps*(sg**6/(q3 - q6)**7 - 2*sg**12/(q3 - q6)**13))*h + p6
    )
}
