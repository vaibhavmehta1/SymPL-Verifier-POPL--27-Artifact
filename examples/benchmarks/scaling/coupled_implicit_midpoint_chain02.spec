# Dimension-scaling benchmark: implicit midpoint
# System: coupled harmonic chain: V'_i = q_i + k(q_i-q_{i-1}) + k(q_i-q_{i+1})
#   (nearest-neighbour springs; the DOFs interact).
#
# N = 2 degrees of freedom  (phase-space dimension D = 4).  Auto-
# generated by gen_scaling.py to measure how verification cost grows
# with dimension.

coords q1 q2 p1 p2 Q1 Q2 P1 P2
params h k

pre  dq1 ^ dp1 + dq2 ^ dp2
post dq1 ^ dp1 + dq2 ^ dp2

program {
    (Q1, Q2, P1, P2) := (
        q1,
        q2,
        p1,
        p2
    )
    (Q1, Q2, P1, P2) := solve (a1, a2, b1, b2) -> (
        b1/2,
        b2/2,
        -(a1 + k*(a1 - a2))/2,
        -(a2 + k*(a2 - a1))/2
    )
    (q1, q2) := (
        q1 + h*P1,
        q2 + h*P2
    )
    (p1, p2) := (
        p1 - h*(Q1 + k*(Q1 - Q2)),
        p2 - h*(Q2 + k*(Q2 - Q1))
    )
}
