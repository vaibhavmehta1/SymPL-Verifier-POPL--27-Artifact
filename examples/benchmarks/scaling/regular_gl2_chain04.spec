# Dimension-scaling benchmark: Gauss-Legendre 2 (GL-2)
# System: regular harmonic oscillators: V'_i = q_i
#   (N independent DOFs; no coupling).
#
# N = 4 degrees of freedom  (phase-space dimension D = 8).  Auto-
# generated by gen_scaling.py to measure how verification cost grows
# with dimension.

coords q1 q2 q3 q4 p1 p2 p3 p4 Qa1 Qa2 Qa3 Qa4 Pa1 Pa2 Pa3 Pa4 Qb1 Qb2 Qb3 Qb4 Pb1 Pb2 Pb3 Pb4
params h

pre  dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4
post dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4

program {
    (Qa1, Qa2, Qa3, Qa4, Pa1, Pa2, Pa3, Pa4, Qb1, Qb2, Qb3, Qb4, Pb1, Pb2, Pb3, Pb4) := (
        q1,
        q2,
        q3,
        q4,
        p1,
        p2,
        p3,
        p4,
        q1,
        q2,
        q3,
        q4,
        p1,
        p2,
        p3,
        p4
    )
    (Qa1, Qa2, Qa3, Qa4, Pa1, Pa2, Pa3, Pa4, Qb1, Qb2, Qb3, Qb4, Pb1, Pb2, Pb3, Pb4) := solve (ga1, ga2, ga3, ga4, ra1, ra2, ra3, ra4, gb1, gb2, gb3, gb4, rb1, rb2, rb3, rb4) -> (
        1/4*ra1 + (1/4 - sqrt(3)/6)*rb1,
        1/4*ra2 + (1/4 - sqrt(3)/6)*rb2,
        1/4*ra3 + (1/4 - sqrt(3)/6)*rb3,
        1/4*ra4 + (1/4 - sqrt(3)/6)*rb4,
        -(1/4*(ga1) + (1/4 - sqrt(3)/6)*(gb1)),
        -(1/4*(ga2) + (1/4 - sqrt(3)/6)*(gb2)),
        -(1/4*(ga3) + (1/4 - sqrt(3)/6)*(gb3)),
        -(1/4*(ga4) + (1/4 - sqrt(3)/6)*(gb4)),
        (1/4 + sqrt(3)/6)*ra1 + 1/4*rb1,
        (1/4 + sqrt(3)/6)*ra2 + 1/4*rb2,
        (1/4 + sqrt(3)/6)*ra3 + 1/4*rb3,
        (1/4 + sqrt(3)/6)*ra4 + 1/4*rb4,
        -((1/4 + sqrt(3)/6)*(ga1) + 1/4*(gb1)),
        -((1/4 + sqrt(3)/6)*(ga2) + 1/4*(gb2)),
        -((1/4 + sqrt(3)/6)*(ga3) + 1/4*(gb3)),
        -((1/4 + sqrt(3)/6)*(ga4) + 1/4*(gb4))
    )
    (q1, q2, q3, q4) := (
        q1 + h*((1/2)*Pa1 + (1/2)*Pb1),
        q2 + h*((1/2)*Pa2 + (1/2)*Pb2),
        q3 + h*((1/2)*Pa3 + (1/2)*Pb3),
        q4 + h*((1/2)*Pa4 + (1/2)*Pb4)
    )
    (p1, p2, p3, p4) := (
        p1 - h*((1/2)*(Qa1) + (1/2)*(Qb1)),
        p2 - h*((1/2)*(Qa2) + (1/2)*(Qb2)),
        p3 - h*((1/2)*(Qa3) + (1/2)*(Qb3)),
        p4 - h*((1/2)*(Qa4) + (1/2)*(Qb4))
    )
}
