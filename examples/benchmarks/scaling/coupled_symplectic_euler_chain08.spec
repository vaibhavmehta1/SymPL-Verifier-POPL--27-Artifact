# Dimension-scaling benchmark: symplectic Euler
# System: coupled harmonic chain: V'_i = q_i + k(q_i-q_{i-1}) + k(q_i-q_{i+1})
#   (nearest-neighbour springs; the DOFs interact).
#
# N = 8 degrees of freedom  (phase-space dimension D = 16).  Auto-
# generated by gen_scaling.py to measure how verification cost grows
# with dimension.

coords q1 q2 q3 q4 q5 q6 q7 q8 p1 p2 p3 p4 p5 p6 p7 p8
params h k

pre  dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4 + dq5 ^ dp5 + dq6 ^ dp6 + dq7 ^ dp7 + dq8 ^ dp8
post dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4 + dq5 ^ dp5 + dq6 ^ dp6 + dq7 ^ dp7 + dq8 ^ dp8

program {
    (p1, p2, p3, p4, p5, p6, p7, p8) := (
        p1 - h*(q1 + k*(q1 - q2)),
        p2 - h*(q2 + k*(q2 - q1) + k*(q2 - q3)),
        p3 - h*(q3 + k*(q3 - q2) + k*(q3 - q4)),
        p4 - h*(q4 + k*(q4 - q3) + k*(q4 - q5)),
        p5 - h*(q5 + k*(q5 - q4) + k*(q5 - q6)),
        p6 - h*(q6 + k*(q6 - q5) + k*(q6 - q7)),
        p7 - h*(q7 + k*(q7 - q6) + k*(q7 - q8)),
        p8 - h*(q8 + k*(q8 - q7))
    )
    (q1, q2, q3, q4, q5, q6, q7, q8) := (
        q1 + h*p1,
        q2 + h*p2,
        q3 + h*p3,
        q4 + h*p4,
        q5 + h*p5,
        q6 + h*p6,
        q7 + h*p7,
        q8 + h*p8
    )
}
