# Dimension-scaling benchmark: leapfrog (KDK)
# System: coupled harmonic chain: V'_i = q_i + k(q_i-q_{i-1}) + k(q_i-q_{i+1})
#   (nearest-neighbour springs; the DOFs interact).
#
# N = 2 degrees of freedom  (phase-space dimension D = 4).  Auto-
# generated by gen_scaling.py to measure how verification cost grows
# with dimension.

coords q1 q2 p1 p2
params h k

pre  dq1 ^ dp1 + dq2 ^ dp2
post dq1 ^ dp1 + dq2 ^ dp2

program {
    (p1, p2) := (
        p1 - (h/2)*(q1 + k*(q1 - q2)),
        p2 - (h/2)*(q2 + k*(q2 - q1))
    )
    (q1, q2) := (
        q1 + h*p1,
        q2 + h*p2
    )
    (p1, p2) := (
        p1 - (h/2)*(q1 + k*(q1 - q2)),
        p2 - (h/2)*(q2 + k*(q2 - q1))
    )
}
