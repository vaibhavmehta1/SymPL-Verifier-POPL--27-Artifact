# Dimension-scaling benchmark: implicit midpoint
# System: coupled harmonic chain: V'_i = q_i + k(q_i-q_{i-1}) + k(q_i-q_{i+1})
#   (nearest-neighbour springs; the DOFs interact).
#
# N = 16 degrees of freedom  (phase-space dimension D = 32).  Auto-
# generated by gen_scaling.py to measure how verification cost grows
# with dimension.

coords q1 q2 q3 q4 q5 q6 q7 q8 q9 q10 q11 q12 q13 q14 q15 q16 p1 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 p13 p14 p15 p16 Q1 Q2 Q3 Q4 Q5 Q6 Q7 Q8 Q9 Q10 Q11 Q12 Q13 Q14 Q15 Q16 P1 P2 P3 P4 P5 P6 P7 P8 P9 P10 P11 P12 P13 P14 P15 P16
params h k

pre  dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4 + dq5 ^ dp5 + dq6 ^ dp6 + dq7 ^ dp7 + dq8 ^ dp8 + dq9 ^ dp9 + dq10 ^ dp10 + dq11 ^ dp11 + dq12 ^ dp12 + dq13 ^ dp13 + dq14 ^ dp14 + dq15 ^ dp15 + dq16 ^ dp16
post dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4 + dq5 ^ dp5 + dq6 ^ dp6 + dq7 ^ dp7 + dq8 ^ dp8 + dq9 ^ dp9 + dq10 ^ dp10 + dq11 ^ dp11 + dq12 ^ dp12 + dq13 ^ dp13 + dq14 ^ dp14 + dq15 ^ dp15 + dq16 ^ dp16

program {
    (Q1, Q2, Q3, Q4, Q5, Q6, Q7, Q8, Q9, Q10, Q11, Q12, Q13, Q14, Q15, Q16, P1, P2, P3, P4, P5, P6, P7, P8, P9, P10, P11, P12, P13, P14, P15, P16) := (
        q1,
        q2,
        q3,
        q4,
        q5,
        q6,
        q7,
        q8,
        q9,
        q10,
        q11,
        q12,
        q13,
        q14,
        q15,
        q16,
        p1,
        p2,
        p3,
        p4,
        p5,
        p6,
        p7,
        p8,
        p9,
        p10,
        p11,
        p12,
        p13,
        p14,
        p15,
        p16
    )
    (Q1, Q2, Q3, Q4, Q5, Q6, Q7, Q8, Q9, Q10, Q11, Q12, Q13, Q14, Q15, Q16, P1, P2, P3, P4, P5, P6, P7, P8, P9, P10, P11, P12, P13, P14, P15, P16) := solve (a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16) -> (
        b1/2,
        b2/2,
        b3/2,
        b4/2,
        b5/2,
        b6/2,
        b7/2,
        b8/2,
        b9/2,
        b10/2,
        b11/2,
        b12/2,
        b13/2,
        b14/2,
        b15/2,
        b16/2,
        -(a1 + k*(a1 - a2))/2,
        -(a2 + k*(a2 - a1) + k*(a2 - a3))/2,
        -(a3 + k*(a3 - a2) + k*(a3 - a4))/2,
        -(a4 + k*(a4 - a3) + k*(a4 - a5))/2,
        -(a5 + k*(a5 - a4) + k*(a5 - a6))/2,
        -(a6 + k*(a6 - a5) + k*(a6 - a7))/2,
        -(a7 + k*(a7 - a6) + k*(a7 - a8))/2,
        -(a8 + k*(a8 - a7) + k*(a8 - a9))/2,
        -(a9 + k*(a9 - a8) + k*(a9 - a10))/2,
        -(a10 + k*(a10 - a9) + k*(a10 - a11))/2,
        -(a11 + k*(a11 - a10) + k*(a11 - a12))/2,
        -(a12 + k*(a12 - a11) + k*(a12 - a13))/2,
        -(a13 + k*(a13 - a12) + k*(a13 - a14))/2,
        -(a14 + k*(a14 - a13) + k*(a14 - a15))/2,
        -(a15 + k*(a15 - a14) + k*(a15 - a16))/2,
        -(a16 + k*(a16 - a15))/2
    )
    (q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, q11, q12, q13, q14, q15, q16) := (
        q1 + h*P1,
        q2 + h*P2,
        q3 + h*P3,
        q4 + h*P4,
        q5 + h*P5,
        q6 + h*P6,
        q7 + h*P7,
        q8 + h*P8,
        q9 + h*P9,
        q10 + h*P10,
        q11 + h*P11,
        q12 + h*P12,
        q13 + h*P13,
        q14 + h*P14,
        q15 + h*P15,
        q16 + h*P16
    )
    (p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13, p14, p15, p16) := (
        p1 - h*(Q1 + k*(Q1 - Q2)),
        p2 - h*(Q2 + k*(Q2 - Q1) + k*(Q2 - Q3)),
        p3 - h*(Q3 + k*(Q3 - Q2) + k*(Q3 - Q4)),
        p4 - h*(Q4 + k*(Q4 - Q3) + k*(Q4 - Q5)),
        p5 - h*(Q5 + k*(Q5 - Q4) + k*(Q5 - Q6)),
        p6 - h*(Q6 + k*(Q6 - Q5) + k*(Q6 - Q7)),
        p7 - h*(Q7 + k*(Q7 - Q6) + k*(Q7 - Q8)),
        p8 - h*(Q8 + k*(Q8 - Q7) + k*(Q8 - Q9)),
        p9 - h*(Q9 + k*(Q9 - Q8) + k*(Q9 - Q10)),
        p10 - h*(Q10 + k*(Q10 - Q9) + k*(Q10 - Q11)),
        p11 - h*(Q11 + k*(Q11 - Q10) + k*(Q11 - Q12)),
        p12 - h*(Q12 + k*(Q12 - Q11) + k*(Q12 - Q13)),
        p13 - h*(Q13 + k*(Q13 - Q12) + k*(Q13 - Q14)),
        p14 - h*(Q14 + k*(Q14 - Q13) + k*(Q14 - Q15)),
        p15 - h*(Q15 + k*(Q15 - Q14) + k*(Q15 - Q16)),
        p16 - h*(Q16 + k*(Q16 - Q15))
    )
}
