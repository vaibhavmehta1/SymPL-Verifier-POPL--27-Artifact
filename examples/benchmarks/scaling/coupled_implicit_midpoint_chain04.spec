# Dimension-scaling benchmark: implicit midpoint
# System: coupled harmonic chain: V'_i = q_i + k(q_i-q_{i-1}) + k(q_i-q_{i+1})
#   (nearest-neighbour springs; the DOFs interact).
#
# N = 4 degrees of freedom  (phase-space dimension D = 8).  Auto-
# generated by gen_scaling.py to measure how verification cost grows
# with dimension.

coords q1 q2 q3 q4 p1 p2 p3 p4 Q1 Q2 Q3 Q4 P1 P2 P3 P4
params h k

pre  dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4
post dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4

program {
    (Q1, Q2, Q3, Q4, P1, P2, P3, P4) := (
        q1,
        q2,
        q3,
        q4,
        p1,
        p2,
        p3,
        p4
    )
    (Q1, Q2, Q3, Q4, P1, P2, P3, P4) := solve (a1, a2, a3, a4, b1, b2, b3, b4) -> (
        b1/2,
        b2/2,
        b3/2,
        b4/2,
        -(a1 + k*(a1 - a2))/2,
        -(a2 + k*(a2 - a1) + k*(a2 - a3))/2,
        -(a3 + k*(a3 - a2) + k*(a3 - a4))/2,
        -(a4 + k*(a4 - a3))/2
    )
    (q1, q2, q3, q4) := (
        q1 + h*P1,
        q2 + h*P2,
        q3 + h*P3,
        q4 + h*P4
    )
    (p1, p2, p3, p4) := (
        p1 - h*(Q1 + k*(Q1 - Q2)),
        p2 - h*(Q2 + k*(Q2 - Q1) + k*(Q2 - Q3)),
        p3 - h*(Q3 + k*(Q3 - Q2) + k*(Q3 - Q4)),
        p4 - h*(Q4 + k*(Q4 - Q3))
    )
}
