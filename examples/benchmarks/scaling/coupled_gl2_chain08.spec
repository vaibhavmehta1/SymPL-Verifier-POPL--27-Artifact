# Dimension-scaling benchmark: Gauss-Legendre 2 (GL-2)
# System: coupled harmonic chain: V'_i = q_i + k(q_i-q_{i-1}) + k(q_i-q_{i+1})
#   (nearest-neighbour springs; the DOFs interact).
#
# N = 8 degrees of freedom  (phase-space dimension D = 16).  Auto-
# generated by gen_scaling.py to measure how verification cost grows
# with dimension.

coords q1 q2 q3 q4 q5 q6 q7 q8 p1 p2 p3 p4 p5 p6 p7 p8 Qa1 Qa2 Qa3 Qa4 Qa5 Qa6 Qa7 Qa8 Pa1 Pa2 Pa3 Pa4 Pa5 Pa6 Pa7 Pa8 Qb1 Qb2 Qb3 Qb4 Qb5 Qb6 Qb7 Qb8 Pb1 Pb2 Pb3 Pb4 Pb5 Pb6 Pb7 Pb8
params h k

pre  dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4 + dq5 ^ dp5 + dq6 ^ dp6 + dq7 ^ dp7 + dq8 ^ dp8
post dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4 + dq5 ^ dp5 + dq6 ^ dp6 + dq7 ^ dp7 + dq8 ^ dp8

program {
    (Qa1, Qa2, Qa3, Qa4, Qa5, Qa6, Qa7, Qa8, Pa1, Pa2, Pa3, Pa4, Pa5, Pa6, Pa7, Pa8, Qb1, Qb2, Qb3, Qb4, Qb5, Qb6, Qb7, Qb8, Pb1, Pb2, Pb3, Pb4, Pb5, Pb6, Pb7, Pb8) := (
        q1,
        q2,
        q3,
        q4,
        q5,
        q6,
        q7,
        q8,
        p1,
        p2,
        p3,
        p4,
        p5,
        p6,
        p7,
        p8,
        q1,
        q2,
        q3,
        q4,
        q5,
        q6,
        q7,
        q8,
        p1,
        p2,
        p3,
        p4,
        p5,
        p6,
        p7,
        p8
    )
    (Qa1, Qa2, Qa3, Qa4, Qa5, Qa6, Qa7, Qa8, Pa1, Pa2, Pa3, Pa4, Pa5, Pa6, Pa7, Pa8, Qb1, Qb2, Qb3, Qb4, Qb5, Qb6, Qb7, Qb8, Pb1, Pb2, Pb3, Pb4, Pb5, Pb6, Pb7, Pb8) := solve (ga1, ga2, ga3, ga4, ga5, ga6, ga7, ga8, ra1, ra2, ra3, ra4, ra5, ra6, ra7, ra8, gb1, gb2, gb3, gb4, gb5, gb6, gb7, gb8, rb1, rb2, rb3, rb4, rb5, rb6, rb7, rb8) -> (
        1/4*ra1 + (1/4 - sqrt(3)/6)*rb1,
        1/4*ra2 + (1/4 - sqrt(3)/6)*rb2,
        1/4*ra3 + (1/4 - sqrt(3)/6)*rb3,
        1/4*ra4 + (1/4 - sqrt(3)/6)*rb4,
        1/4*ra5 + (1/4 - sqrt(3)/6)*rb5,
        1/4*ra6 + (1/4 - sqrt(3)/6)*rb6,
        1/4*ra7 + (1/4 - sqrt(3)/6)*rb7,
        1/4*ra8 + (1/4 - sqrt(3)/6)*rb8,
        -(1/4*(ga1 + k*(ga1 - ga2)) + (1/4 - sqrt(3)/6)*(gb1 + k*(gb1 - gb2))),
        -(1/4*(ga2 + k*(ga2 - ga1) + k*(ga2 - ga3)) + (1/4 - sqrt(3)/6)*(gb2 + k*(gb2 - gb1) + k*(gb2 - gb3))),
        -(1/4*(ga3 + k*(ga3 - ga2) + k*(ga3 - ga4)) + (1/4 - sqrt(3)/6)*(gb3 + k*(gb3 - gb2) + k*(gb3 - gb4))),
        -(1/4*(ga4 + k*(ga4 - ga3) + k*(ga4 - ga5)) + (1/4 - sqrt(3)/6)*(gb4 + k*(gb4 - gb3) + k*(gb4 - gb5))),
        -(1/4*(ga5 + k*(ga5 - ga4) + k*(ga5 - ga6)) + (1/4 - sqrt(3)/6)*(gb5 + k*(gb5 - gb4) + k*(gb5 - gb6))),
        -(1/4*(ga6 + k*(ga6 - ga5) + k*(ga6 - ga7)) + (1/4 - sqrt(3)/6)*(gb6 + k*(gb6 - gb5) + k*(gb6 - gb7))),
        -(1/4*(ga7 + k*(ga7 - ga6) + k*(ga7 - ga8)) + (1/4 - sqrt(3)/6)*(gb7 + k*(gb7 - gb6) + k*(gb7 - gb8))),
        -(1/4*(ga8 + k*(ga8 - ga7)) + (1/4 - sqrt(3)/6)*(gb8 + k*(gb8 - gb7))),
        (1/4 + sqrt(3)/6)*ra1 + 1/4*rb1,
        (1/4 + sqrt(3)/6)*ra2 + 1/4*rb2,
        (1/4 + sqrt(3)/6)*ra3 + 1/4*rb3,
        (1/4 + sqrt(3)/6)*ra4 + 1/4*rb4,
        (1/4 + sqrt(3)/6)*ra5 + 1/4*rb5,
        (1/4 + sqrt(3)/6)*ra6 + 1/4*rb6,
        (1/4 + sqrt(3)/6)*ra7 + 1/4*rb7,
        (1/4 + sqrt(3)/6)*ra8 + 1/4*rb8,
        -((1/4 + sqrt(3)/6)*(ga1 + k*(ga1 - ga2)) + 1/4*(gb1 + k*(gb1 - gb2))),
        -((1/4 + sqrt(3)/6)*(ga2 + k*(ga2 - ga1) + k*(ga2 - ga3)) + 1/4*(gb2 + k*(gb2 - gb1) + k*(gb2 - gb3))),
        -((1/4 + sqrt(3)/6)*(ga3 + k*(ga3 - ga2) + k*(ga3 - ga4)) + 1/4*(gb3 + k*(gb3 - gb2) + k*(gb3 - gb4))),
        -((1/4 + sqrt(3)/6)*(ga4 + k*(ga4 - ga3) + k*(ga4 - ga5)) + 1/4*(gb4 + k*(gb4 - gb3) + k*(gb4 - gb5))),
        -((1/4 + sqrt(3)/6)*(ga5 + k*(ga5 - ga4) + k*(ga5 - ga6)) + 1/4*(gb5 + k*(gb5 - gb4) + k*(gb5 - gb6))),
        -((1/4 + sqrt(3)/6)*(ga6 + k*(ga6 - ga5) + k*(ga6 - ga7)) + 1/4*(gb6 + k*(gb6 - gb5) + k*(gb6 - gb7))),
        -((1/4 + sqrt(3)/6)*(ga7 + k*(ga7 - ga6) + k*(ga7 - ga8)) + 1/4*(gb7 + k*(gb7 - gb6) + k*(gb7 - gb8))),
        -((1/4 + sqrt(3)/6)*(ga8 + k*(ga8 - ga7)) + 1/4*(gb8 + k*(gb8 - gb7)))
    )
    (q1, q2, q3, q4, q5, q6, q7, q8) := (
        q1 + h*((1/2)*Pa1 + (1/2)*Pb1),
        q2 + h*((1/2)*Pa2 + (1/2)*Pb2),
        q3 + h*((1/2)*Pa3 + (1/2)*Pb3),
        q4 + h*((1/2)*Pa4 + (1/2)*Pb4),
        q5 + h*((1/2)*Pa5 + (1/2)*Pb5),
        q6 + h*((1/2)*Pa6 + (1/2)*Pb6),
        q7 + h*((1/2)*Pa7 + (1/2)*Pb7),
        q8 + h*((1/2)*Pa8 + (1/2)*Pb8)
    )
    (p1, p2, p3, p4, p5, p6, p7, p8) := (
        p1 - h*((1/2)*(Qa1 + k*(Qa1 - Qa2)) + (1/2)*(Qb1 + k*(Qb1 - Qb2))),
        p2 - h*((1/2)*(Qa2 + k*(Qa2 - Qa1) + k*(Qa2 - Qa3)) + (1/2)*(Qb2 + k*(Qb2 - Qb1) + k*(Qb2 - Qb3))),
        p3 - h*((1/2)*(Qa3 + k*(Qa3 - Qa2) + k*(Qa3 - Qa4)) + (1/2)*(Qb3 + k*(Qb3 - Qb2) + k*(Qb3 - Qb4))),
        p4 - h*((1/2)*(Qa4 + k*(Qa4 - Qa3) + k*(Qa4 - Qa5)) + (1/2)*(Qb4 + k*(Qb4 - Qb3) + k*(Qb4 - Qb5))),
        p5 - h*((1/2)*(Qa5 + k*(Qa5 - Qa4) + k*(Qa5 - Qa6)) + (1/2)*(Qb5 + k*(Qb5 - Qb4) + k*(Qb5 - Qb6))),
        p6 - h*((1/2)*(Qa6 + k*(Qa6 - Qa5) + k*(Qa6 - Qa7)) + (1/2)*(Qb6 + k*(Qb6 - Qb5) + k*(Qb6 - Qb7))),
        p7 - h*((1/2)*(Qa7 + k*(Qa7 - Qa6) + k*(Qa7 - Qa8)) + (1/2)*(Qb7 + k*(Qb7 - Qb6) + k*(Qb7 - Qb8))),
        p8 - h*((1/2)*(Qa8 + k*(Qa8 - Qa7)) + (1/2)*(Qb8 + k*(Qb8 - Qb7)))
    )
}
