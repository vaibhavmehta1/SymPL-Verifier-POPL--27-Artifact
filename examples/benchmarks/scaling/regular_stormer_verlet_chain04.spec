# Dimension-scaling benchmark: Stoermer-Verlet (DKD)
# System: regular harmonic oscillators: V'_i = q_i
#   (N independent DOFs; no coupling).
#
# N = 4 degrees of freedom  (phase-space dimension D = 8).  Auto-
# generated by gen_scaling.py to measure how verification cost grows
# with dimension.

coords q1 q2 q3 q4 p1 p2 p3 p4
params h

pre  dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4
post dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4

program {
    (q1, q2, q3, q4) := (
        q1 + (h/2)*p1,
        q2 + (h/2)*p2,
        q3 + (h/2)*p3,
        q4 + (h/2)*p4
    )
    (p1, p2, p3, p4) := (
        p1 - h*(q1),
        p2 - h*(q2),
        p3 - h*(q3),
        p4 - h*(q4)
    )
    (q1, q2, q3, q4) := (
        q1 + (h/2)*p1,
        q2 + (h/2)*p2,
        q3 + (h/2)*p3,
        q4 + (h/2)*p4
    )
}
