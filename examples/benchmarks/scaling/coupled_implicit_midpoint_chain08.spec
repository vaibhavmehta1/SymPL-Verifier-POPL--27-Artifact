# Dimension-scaling benchmark: implicit midpoint
# System: coupled harmonic chain: V'_i = q_i + k(q_i-q_{i-1}) + k(q_i-q_{i+1})
#   (nearest-neighbour springs; the DOFs interact).
#
# N = 8 degrees of freedom  (phase-space dimension D = 16).  Auto-
# generated by gen_scaling.py to measure how verification cost grows
# with dimension.

coords q1 q2 q3 q4 q5 q6 q7 q8 p1 p2 p3 p4 p5 p6 p7 p8 Q1 Q2 Q3 Q4 Q5 Q6 Q7 Q8 P1 P2 P3 P4 P5 P6 P7 P8
params h k

pre  dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4 + dq5 ^ dp5 + dq6 ^ dp6 + dq7 ^ dp7 + dq8 ^ dp8
post dq1 ^ dp1 + dq2 ^ dp2 + dq3 ^ dp3 + dq4 ^ dp4 + dq5 ^ dp5 + dq6 ^ dp6 + dq7 ^ dp7 + dq8 ^ dp8

program {
    (Q1, Q2, Q3, Q4, Q5, Q6, Q7, Q8, P1, P2, P3, P4, P5, P6, P7, P8) := (
        q1,
        q2,
        q3,
        q4,
        q5,
        q6,
        q7,
        q8,
        p1,
        p2,
        p3,
        p4,
        p5,
        p6,
        p7,
        p8
    )
    (Q1, Q2, Q3, Q4, Q5, Q6, Q7, Q8, P1, P2, P3, P4, P5, P6, P7, P8) := solve (a1, a2, a3, a4, a5, a6, a7, a8, b1, b2, b3, b4, b5, b6, b7, b8) -> (
        b1/2,
        b2/2,
        b3/2,
        b4/2,
        b5/2,
        b6/2,
        b7/2,
        b8/2,
        -(a1 + k*(a1 - a2))/2,
        -(a2 + k*(a2 - a1) + k*(a2 - a3))/2,
        -(a3 + k*(a3 - a2) + k*(a3 - a4))/2,
        -(a4 + k*(a4 - a3) + k*(a4 - a5))/2,
        -(a5 + k*(a5 - a4) + k*(a5 - a6))/2,
        -(a6 + k*(a6 - a5) + k*(a6 - a7))/2,
        -(a7 + k*(a7 - a6) + k*(a7 - a8))/2,
        -(a8 + k*(a8 - a7))/2
    )
    (q1, q2, q3, q4, q5, q6, q7, q8) := (
        q1 + h*P1,
        q2 + h*P2,
        q3 + h*P3,
        q4 + h*P4,
        q5 + h*P5,
        q6 + h*P6,
        q7 + h*P7,
        q8 + h*P8
    )
    (p1, p2, p3, p4, p5, p6, p7, p8) := (
        p1 - h*(Q1 + k*(Q1 - Q2)),
        p2 - h*(Q2 + k*(Q2 - Q1) + k*(Q2 - Q3)),
        p3 - h*(Q3 + k*(Q3 - Q2) + k*(Q3 - Q4)),
        p4 - h*(Q4 + k*(Q4 - Q3) + k*(Q4 - Q5)),
        p5 - h*(Q5 + k*(Q5 - Q4) + k*(Q5 - Q6)),
        p6 - h*(Q6 + k*(Q6 - Q5) + k*(Q6 - Q7)),
        p7 - h*(Q7 + k*(Q7 - Q6) + k*(Q7 - Q8)),
        p8 - h*(Q8 + k*(Q8 - Q7))
    )
}
